{
  "name": "tradeflow",
  "version": "0.1.0",
  "private": true,
  "description": "Run your entire trade business from one place — jobs, quotes, invoices, reports and email for trades and field-service businesses.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "test:watch": "vitest",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:reset": "node scripts/db-push.mjs --reset",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
