# ---------------------------------------------------------------------------
# TradeFlow environment
#
# Copy to `.env.local` and fill in. `npm run setup` walks you through it and
# writes the file for you.
#
# Only the values under REQUIRED are needed to run the whole platform. Every
# OPTIONAL block degrades gracefully: the feature stays visible and tells you
# which key it is waiting for instead of throwing.
# ---------------------------------------------------------------------------

# --- REQUIRED: Supabase -----------------------------------------------------
# From your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Never prefixed with NEXT_PUBLIC_, never imported by a client
# component. Used by the migration runner, the seeder, storage signing and the
# small number of admin operations that must bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct Postgres connection, used only by `npm run db:push` / `npm run db:seed`.
# Supabase project: Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- REQUIRED: the app's own URL --------------------------------------------
# Used for auth redirects, quote share links and e-mail links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OPTIONAL: AI assistant --------------------------------------------------
# Without this the AI panels render and explain that a key is needed; nothing
# else in the app is affected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OPTIONAL: outbound e-mail ----------------------------------------------
# Provider is `resend`, `smtp` or `log`. `log` is the default and records every
# outbound message in the database + server log without sending it, so the
# whole send pipeline is testable with no account anywhere.
EMAIL_PROVIDER=log
EMAIL_FROM="TradeFlow <no-reply@example.com>"
RESEND_API_KEY=
SMTP_URL=

# --- OPTIONAL: the phone agent ----------------------------------------------
# The AI answers your business number through a telephony provider. The webhook
# implementation is complete; what cannot be created for you is a phone number
# on an account in your name. Buy one in the Twilio console, point its voice
# webhook at https://YOUR-APP/api/voice/incoming (HTTP POST) and its status
# callback at /api/voice/status, then paste the account's auth token here.
#
# Every voice webhook verifies this signature. With the token unset the routes
# refuse every request rather than answering an unauthenticated one.
TWILIO_AUTH_TOKEN=

# --- OPTIONAL: mailbox connection (OAuth) -----------------------------------
# NOT YET IMPLEMENTED. Outbound email works today (see EMAIL_PROVIDER above):
# quotes, invoices and reports are composed, sent and recorded against the job.
# What is missing is the inbound half — connecting an existing Gmail or Outlook
# mailbox so received messages land on the job they belong to. The schema
# (email_accounts, email_threads, emails, email_attachments), the encrypted
# token columns and the interface are in place; the OAuth callback and the sync
# are not written yet. These variables are reserved for them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Encrypts stored mailbox refresh tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
