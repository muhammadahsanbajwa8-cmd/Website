# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Postgres connection string used by both Prisma migrations and the client.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# Separate database for `npm test`, so a test run cannot wipe your dev data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_test?schema=public"

# Signing key for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start if this is missing or shorter than 32 characters.
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

PORT=3000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"

# bcrypt work factor. 12 is a reasonable 2026 default; lower it to 4 in tests
# only, never in a deployed environment.
BCRYPT_ROUNDS=12
