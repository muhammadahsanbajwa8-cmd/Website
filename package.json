{
  "name": "holiday-board",
  "version": "1.0.0",
  "private": true,
  "description": "Static generator for public holiday calendars and working-day counts, for every country with open data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:offline": "node build.mjs --offline",
    "test": "node --test test/*.test.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "serve": "node tools/serve.mjs",
    "preview": "node tools/preview.mjs",
    "events:check": "node tools/events-check.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
